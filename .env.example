# Chatio Backend Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# SQLite (default for local development)
DATABASE_URL=sqlite:///./chatio.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/chatio_db

# JWT Configuration
SECRET_KEY=your-very-long-random-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys - LINE Official Account
# Get these from https://developers.line.biz/
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# API Keys - Facebook (for Messenger and Instagram DM)
# Get these from https://developers.facebook.com/
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-access-token

# API Keys - Instagram
# Get these from https://developers.facebook.com/
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# API Keys - Twitter/X
# Get these from https://developer.twitter.com/
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# API Keys - LinkedIn
# Get these from https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Application Settings
APP_NAME=Chatio
DEBUG=True
ENVIRONMENT=development

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# API URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
